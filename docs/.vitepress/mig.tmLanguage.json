{
  "name": "mig",
  "displayName": "ffmig migration",
  "scopeName": "source.mig",
  "fileTypes": ["mig"],
  "embeddedLangs": ["sql"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#migration" },
    { "include": "#section" },
    { "include": "#operation" },
    { "include": "#column" },
    { "include": "#multiline-string" },
    { "include": "#string" },
    { "include": "#label" },
    { "include": "#symbol" },
    { "include": "#constant" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.mig",
      "match": "#.*$"
    },
    "migration": {
      "match": "\\b(migration)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.mig" },
        "2": { "name": "entity.name.type.mig" }
      }
    },
    "section": {
      "match": "\\b(change|up|down)(?=\\s*\\{)",
      "name": "keyword.control.mig"
    },
    "operation": {
      "match": "\\b(create_table|drop_table|rename_table|add_column|remove_column|rename_column|change_column_null|change_column_default|change_column|add_index|remove_index|rename_index|add_reference|remove_reference|add_foreign_key|remove_foreign_key|execute)\\b(?!:)",
      "name": "entity.name.function.mig"
    },
    "column": {
      "match": "^\\s*(string|text|integer|bigint|float|decimal|boolean|date|datetime|time|binary|uuid|json|references|timestamps)\\b(?!:)",
      "captures": {
        "1": { "name": "storage.type.mig" }
      }
    },
    "multiline-string": {
      "name": "string.quoted.triple.mig",
      "begin": "\"\"\"",
      "end": "(?<!\\\\)\"\"\"",
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        { "include": "#escape" },
        { "include": "source.sql" }
      ]
    },
    "string": {
      "name": "string.quoted.double.mig",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#escape" }]
    },
    "escape": {
      "name": "constant.character.escape.mig",
      "match": "\\\\[\"\\\\nt]"
    },
    "label": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)",
      "captures": {
        "1": { "name": "variable.parameter.mig" },
        "2": { "name": "punctuation.separator.key-value.mig" }
      }
    },
    "symbol": {
      "match": "(?<![A-Za-z0-9_]):[A-Za-z_][A-Za-z0-9_]*",
      "name": "constant.other.symbol.mig"
    },
    "constant": {
      "match": "\\b(true|false|nil)\\b",
      "name": "constant.language.mig"
    },
    "number": {
      "match": "-?\\b[0-9]+\\b",
      "name": "constant.numeric.mig"
    }
  }
}
